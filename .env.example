# Values prefixed with EXPO_PUBLIC_ are bundled into the application.
# Never place passwords, private API keys, or other secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Values are emitted by the backend SAM stack as UserPoolId and
# UserPoolClientId. These identifiers are public application configuration,
# not secrets.
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-2_example
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
